#!/usr/bin/env bash
# ccp — choose which provider Claude Code uses, and manage providers.
#
# Switch:
#   ccp use NAME                 make NAME the provider for every `claude` (Terminal, IDE, new windows)
#   ccp use none                 hand control back to Claude Code's own sign-in
#   ccp status                   which provider is active, and whether Claude Code's settings still match it
#
# Run:
#   ccp                          Claude Code with the active provider
#   ccp NAME [claude args]       one session with another provider, e.g.  ccp vertex -c
#
# Manage providers (settings live in ~/.claude-providers):
#   ccp list                     providers with descriptions (* = active)
#   ccp templates                provider types you can add
#   ccp add [NAME] [-t TYPE]     create a provider; asks for each value, secrets go to the Keychain
#   ccp import NAME              turn the provider settings now in ~/.claude/settings.json into a provider
#   ccp edit NAME                open NAME.env in your editor
#   ccp key NAME [VAR]           (re)enter a secret stored in the Keychain
#   ccp remove NAME              delete a provider and its Keychain items
#   ccp show [NAME]              print the resolved settings (secrets masked)
#   ccp test [NAME]              make one real request through the provider
#   ccp doctor                   look for things that override ccp
#   ccp overrides [--fix]        provider variables in ~/.claude/settings.json that ccp didn't put there
#   ccp shell install|remove|status   optional: record plain `claude` launches for the Usage page
#
# How switching works: `ccp use` writes the provider's variables into the "env" block of
# ~/.claude/settings.json, which Claude Code applies to every session wherever it starts. API keys and
# tokens stay in the Keychain: Claude Code asks `ccp auth` for them (its apiKeyHelper setting).
# Sessions already running keep their provider until restarted.
#
# Every launch is recorded in ~/.claude-providers/usage/runs.log (when, which provider, which folder)
# so Switchboard can attribute Claude Code's token usage to providers.
#
# Non-interactive add:  ccp add NAME -t TYPE --yes --set VAR=value ...   (--force replaces; --keep reuses stored secrets left blank)
#   (secrets: export CCP_SECRET_VAR=value, so they stay off the command line)
#
# New provider types: drop TYPE.tpl into ~/.claude-providers/templates/. Header lines
#   "# description:", "# var: NAME | prompt | default | required", "# secret: ..." define the
#   questions; {{NAME}} marks where answers go; a leading "?" drops a line when its answer is blank.
# A NAME.env may define ccp_check() for custom pre-launch checks (use warn / die).
#
# Provider precedence for a launch: first argument > $CLAUDE_PROVIDER > the active provider.
# CCP_DRY_RUN=1 prints the resolved settings instead of launching claude.

set -u
CCP_VERSION=2

DIR="${CLAUDE_PROVIDERS_DIR:-$HOME/.claude-providers}"
TPL_DIR="$DIR/templates"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CLAUDE_DIR/settings.json"
APPLIED="$DIR/applied"
ACCOUNT="${USER:-$(id -un)}"
RESERVED=" help list ls templates template template-vars secrets add new edit remove rm key show test doctor default use status import auth run shell overrides usage none off "
SETS=""; REPL=""; EMPTYV=" "

die()  { echo "ccp: $*" >&2; exit 1; }
warn() { echo "ccp: warning: $*" >&2; }
note() { echo "ccp: $*" >&2; }

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Backslash-escape tabs, newlines and backslashes so a value fits on one tab-separated line.
esc() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# A name that ends in _TOKENS (or has _TOKENS_ in it) is a count such as CLAUDE_CODE_MAX_CONTEXT_TOKENS, not a secret.
is_secret_name() { case "$1" in *_TOKENS|*_TOKENS_*) return 1 ;; *KEY*|*TOKEN*|*SECRET*|*PASSWORD*) return 0 ;; *) return 1 ;; esac; }
# Mask the values of secret-looking keys in a JSON document on stdin.
mask_json() {
  perl -pe 's/"([A-Za-z0-9_]+)"(\s*:\s*")([^"]*)/ my ($k,$sep,$v)=($1,$2,$3); ($k =~ m{KEY|TOKEN|SECRET|PASSWORD} && $k !~ m{_TOKENS(_|$)}) ? "\"$k\"$sep***" : "\"$k\"$sep$v" /ge'
}
# True when an env file exports a secret-looking variable with a literal value (not ccp_secret, not a placeholder, not empty).
plaintext_secret_in() {
  local line v
  while IFS= read -r line; do
    v="${line#*export}"; v="${v%%=*}"; v="${v//[[:space:]]/}"
    is_secret_name "$v" || continue
    case "$line" in *ccp_secret*|*CHANGE_ME*) continue ;; esac
    printf '%s' "$line" | grep -qE "=(''|\"\")?[[:space:]]*(#.*)?$" && continue
    return 0
  done < <(grep -E '^[[:space:]]*export[[:space:]]+[A-Za-z_][A-Za-z0-9_]*=' "$1" 2>/dev/null)
  return 1
}

# ---- Keychain ---------------------------------------------------------------
have_security() { command -v security >/dev/null 2>&1; }
kc_has() { have_security && security find-generic-password -a "$ACCOUNT" -s "$1" >/dev/null 2>&1; }
kc_set() { security add-generic-password -U -a "$ACCOUNT" -s "$1" -w "$2" >/dev/null 2>&1; }
kc_del() { security delete-generic-password -a "$ACCOUNT" -s "$1" >/dev/null 2>&1; }

# Used inside provider files:  export ANTHROPIC_AUTH_TOKEN="$(ccp_secret ccp-NAME-VAR)"
ccp_secret() {
  local v=""
  if have_security; then v="$(security find-generic-password -a "$ACCOUNT" -s "$1" -w 2>/dev/null)"; fi
  if [ -z "$v" ]; then warn "no Keychain item '$1' — fix with: ccp key ${provider:-NAME} ${1#ccp-${provider:-NAME}-}"; fi
  printf '%s' "$v"
}

# ---- prompts ----------------------------------------------------------------
is_tty() { [ -t 0 ] && [ -t 2 ]; }
ask() {
  local ans=""
  if [ -n "${2:-}" ]; then read -r -p "$1 [$2]: " ans </dev/tty; else read -r -p "$1: " ans </dev/tty; fi
  printf '%s' "${ans:-${2:-}}"
}
ask_secret() { local ans=""; read -r -s -p "$1: " ans </dev/tty; echo >&2; printf '%s' "$ans"; }
confirm() { local a=""; read -r -p "$1 [y/N] " a </dev/tty; case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac; }

# ---- providers / templates --------------------------------------------------
list_providers() {
  local f
  for f in "$DIR"/*.env; do
    if [ -e "$f" ]; then basename "$f" .env; fi
  done
}
list_templates() {
  local f
  for f in "$TPL_DIR"/*.tpl; do
    if [ -e "$f" ]; then basename "$f" .tpl; fi
  done
}
# The active provider: the one `ccp use` chose. Empty when none has been chosen.
active_provider() {
  if [ -f "$DIR/default" ]; then head -n1 "$DIR/default"; fi
}
# The provider a launch uses when none is named: $CLAUDE_PROVIDER, else the active one.
default_provider() {
  if [ -n "${CLAUDE_PROVIDER:-}" ]; then echo "$CLAUDE_PROVIDER"; else active_provider; fi
}
desc_of() { sed -n 's/^# description:[[:space:]]*//p' "$1" | head -n1; }
needs_setup() { grep -v '^[[:space:]]*#' "$1" | grep -q 'CHANGE_ME'; }
secret_services() { sed -n 's/^# secret-service:[[:space:]]*//p' "$1"; }
valid_name() {
  case "$1" in ''|*[!A-Za-z0-9_-]*|[-_]*) return 1 ;; esac
  case "$RESERVED" in *" $1 "*) return 1 ;; esac
  return 0
}

# "kind|VAR|prompt|default|required" for each question in a template
tpl_specs() {
  local line kind rest v p d r
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "# var:"*)    kind=var;    rest="${line#"# var:"}" ;;
      "# secret:"*) kind=secret; rest="${line#"# secret:"}" ;;
      *) continue ;;
    esac
    v=""; p=""; d=""; r=""
    IFS='|' read -r v p d r <<EOF
$rest
EOF
    printf '%s|%s|%s|%s|%s\n' "$kind" "$(trim "$v")" "$(trim "$p")" "$(trim "$d")" "$(trim "$r")"
  done < "$1"
}

sets_get() {
  local l
  while IFS= read -r l; do
    if [ -n "$l" ] && [ "${l%%=*}" = "$1" ]; then printf '%s' "${l#*=}"; return 0; fi
  done <<EOF
$SETS
EOF
  return 1
}
repl_of() {
  local l
  while IFS= read -r l; do
    if [ -n "$l" ] && [ "${l%%=*}" = "$1" ]; then printf '%s' "${l#*=}"; return 0; fi
  done <<EOF
$REPL
EOF
  return 1
}

render_line() {
  local line="$1" optional=0 out="" empty=0 pre rest var post rep
  local open='{{' close='}}'
  case "$line" in "?"*) optional=1; line="${line#\?}" ;; esac
  while :; do
    case "$line" in *"$open"*"$close"*) ;; *) break ;; esac
    pre="${line%%"$open"*}"
    rest="${line#*"$open"}"
    var="${rest%%"$close"*}"
    post="${rest#*"$close"}"
    if rep="$(repl_of "$var")"; then :; else rep="''"; empty=1; warn "template placeholder {{$var}} has no matching '# var:' line"; fi
    case "$EMPTYV" in *" $var "*) empty=1 ;; esac
    out="$out$pre$rep"
    line="$post"
  done
  out="$out$line"
  if [ "$optional" = 1 ] && [ "$empty" = 1 ]; then return 0; fi
  printf '%s\n' "$out"
}

# ---- commands ---------------------------------------------------------------
cmd_templates() {
  local t d plain=0
  [ "${1:-}" = "--plain" ] && plain=1
  [ -d "$TPL_DIR" ] || die "no templates folder at $TPL_DIR"
  for t in $(list_templates); do
    d="$(desc_of "$TPL_DIR/$t.tpl")"
    if [ "$plain" = 1 ]; then printf '%s|%s\n' "$t" "$d"; else printf '  %-16s %s\n' "$t" "$d"; fi
  done
}

cmd_list() {
  local cur p f mark d st
  cur="$(active_provider)"
  if [ -z "$(list_providers)" ]; then echo "No providers yet. Add one with: ccp add"; return 0; fi
  for p in $(list_providers); do
    f="$DIR/$p.env"; mark=" "
    if [ "$p" = "$cur" ]; then mark="*"; fi
    d="$(desc_of "$f")"; st=""
    if needs_setup "$f"; then st="   [needs setup: ccp edit $p]"; fi
    printf '%s %-14s %s%s\n' "$mark" "$p" "$d" "$st"
  done
  if [ -z "$cur" ]; then echo "(no provider is active yet: ccp use NAME)"; fi
}

cmd_add() {
  local name="" tpl="" force=0 yes=0 mkdef=0 interactive=0 keep=0
  SETS=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--template) [ $# -ge 2 ] || die "add: $1 needs a value"; tpl="$2"; shift 2 ;;
      --set) [ $# -ge 2 ] || die "add: --set needs VAR=value"
             case "$2" in *=*) SETS="$SETS$2"$'\n' ;; *) die "add: --set needs VAR=value" ;; esac; shift 2 ;;
      -f|--force) force=1; shift ;;
      -y|--yes) yes=1; shift ;;
      --default|--use) mkdef=1; shift ;;
      --keep) keep=1; shift ;;
      -*) die "add: unknown option $1" ;;
      *) if [ -z "$name" ]; then name="$1"; else die "add: unexpected argument $1"; fi; shift ;;
    esac
  done
  if [ "$yes" = 0 ] && is_tty; then interactive=1; fi
  [ -d "$TPL_DIR" ] || die "no templates folder at $TPL_DIR"

  if [ -z "$tpl" ]; then
    [ "$interactive" = 1 ] || die "add: pass --template TYPE (see: ccp templates)"
    local i=0 t names="" pick
    echo "Provider types:" >&2
    for t in $(list_templates); do
      i=$((i+1)); names="$names $t"
      printf '  %d) %-16s %s\n' "$i" "$t" "$(desc_of "$TPL_DIR/$t.tpl")" >&2
    done
    pick="$(ask 'Choose a type (number or name)' '')"
    case "$pick" in
      ''|*[!0-9]*) tpl="$pick" ;;
      *) tpl="$(echo $names | cut -d' ' -f"$pick")" ;;
    esac
  fi
  case "$tpl" in ''|*/*) die "add: unknown template '$tpl' (see: ccp templates)" ;; esac
  local tplf="$TPL_DIR/$tpl.tpl"
  [ -f "$tplf" ] || die "add: unknown template '$tpl' (see: ccp templates)"

  if [ -z "$name" ]; then
    [ "$interactive" = 1 ] || die "add: pass a NAME"
    name="$(ask 'Name for this provider' "$tpl")"
  fi
  valid_name "$name" || die "add: invalid name '$name' (letters, digits, - and _; not a ccp command word)"
  local out="$DIR/$name.env"
  if [ -e "$out" ] && [ "$force" = 0 ]; then die "add: '$name' already exists (replace with --force, or: ccp edit $name)"; fi

  REPL=""; EMPTYV=" "
  local specs kind var prompt def req val repl svc envname kept secrets_header="" knownv=" "
  specs="$(tpl_specs "$tplf")"
  while IFS='|' read -r kind var prompt def req; do
    [ -n "$var" ] || continue
    knownv="$knownv$var "
    val=""
    if val="$(sets_get "$var")"; then :
    elif [ "$kind" = secret ]; then
      envname="CCP_SECRET_$var"; val="${!envname:-}"
      if [ -z "$val" ] && [ "$interactive" = 1 ]; then val="$(ask_secret "$prompt")"; fi
    elif [ "$interactive" = 1 ]; then val="$(ask "$prompt" "$def")"
    else val="$def"; fi
    kept=0
    if [ "$kind" = secret ] && [ -z "$val" ] && [ "$keep" = 1 ] && kc_has "ccp-$name-$var"; then kept=1; fi
    if [ -z "$val" ] && [ "$req" = required ] && [ "$kept" = 0 ]; then
      if [ "$interactive" = 1 ]; then
        while [ -z "$val" ]; do
          if [ "$kind" = secret ]; then val="$(ask_secret "$prompt (required)")"; else val="$(ask "$prompt (required)" "$def")"; fi
        done
      else
        die "add: $var is required (use --set $var=VALUE, or export CCP_SECRET_$var for secrets)"
      fi
    fi
    if [ "$kept" = 1 ]; then
      svc="ccp-$name-$var"
      repl="\"\$(ccp_secret $svc)\""
      secrets_header="$secrets_header# secret-service: $svc"$'\n'
    elif [ "$kind" = secret ] && [ -n "$val" ]; then
      svc="ccp-$name-$var"
      if have_security && kc_set "$svc" "$val"; then
        repl="\"\$(ccp_secret $svc)\""
        secrets_header="$secrets_header# secret-service: $svc"$'\n'
      else
        warn "macOS Keychain unavailable; storing $var in $out (mode 600)"
        repl="$(printf '%q' "$val")"
      fi
    else
      repl="$(printf '%q' "$val")"
    fi
    if [ -z "$val" ] && [ "$kept" = 0 ]; then EMPTYV="$EMPTYV$var "; fi
    REPL="$REPL$var=$repl"$'\n'
  done <<EOF
$specs
EOF
  local l k
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    k="${l%%=*}"
    case "$knownv" in *" $k "*) ;; *) warn "ignoring --set $k (template '$tpl' has no such question)" ;; esac
  done <<EOF
$SETS
EOF

  umask 077
  local tmp line
  tmp="$(mktemp "$DIR/.add.XXXXXX")" || die "add: can't write in $DIR"
  {
    echo "# description: $(desc_of "$tplf")"
    echo "# template: $tpl"
    printf '%s' "$secrets_header"
    echo
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in "# var:"*|"# secret:"*|"# description:"*) continue ;; esac
      render_line "$line"
    done < "$tplf"
  } > "$tmp"
  mv "$tmp" "$out" && chmod 600 "$out"
  note "created $out"
  if [ "$mkdef" = 0 ] && [ "$interactive" = 1 ] && confirm "Switch claude to '$name' now?"; then mkdef=1; fi
  if [ "$mkdef" = 1 ]; then cmd_use "$name"; fi
  return 0
}

cmd_edit() {
  local n="${1:-}" f ed
  [ -n "$n" ] || die "usage: ccp edit NAME"
  f="$DIR/$n.env"; [ -f "$f" ] || die "no provider '$n'"
  ed="${VISUAL:-${EDITOR:-}}"
  if [ -n "$ed" ]; then exec $ed "$f"
  elif command -v open >/dev/null 2>&1; then exec open -t "$f"
  else exec vi "$f"; fi
}

cmd_remove() {
  local n="" yes=0 a f svc services
  for a in "$@"; do case "$a" in -y|--yes) yes=1 ;; *) n="$a" ;; esac; done
  [ -n "$n" ] || die "usage: ccp remove NAME [--yes]"
  f="$DIR/$n.env"; [ -f "$f" ] || die "no provider '$n'"
  services="$(secret_services "$f")"
  if [ "$yes" = 0 ]; then
    is_tty || die "remove: pass --yes to confirm"
    confirm "Delete provider '$n'${services:+ and its Keychain items}?" || { note "cancelled"; return 0; }
  fi
  if [ "$(active_provider)" = "$n" ]; then
    settings_clear
    rm -f "$DIR/default" "$APPLIED"
    note "$n was the active provider; Claude Code is back to its own sign-in"
  fi
  if [ -n "$services" ]; then
    while IFS= read -r svc; do
      [ -n "$svc" ] || continue
      if have_security; then kc_del "$svc"; fi
    done <<EOF
$services
EOF
  fi
  rm -f "$f"
  note "removed $n"
}

cmd_key() {
  local n="${1:-}" only="${2:-}" f svc var val envname did=0 services
  [ -n "$n" ] || die "usage: ccp key NAME [VAR]"
  f="$DIR/$n.env"; [ -f "$f" ] || die "no provider '$n'"
  have_security || die "key: the macOS Keychain ('security') isn't available here"
  local ttyok=0
  if is_tty; then ttyok=1; fi
  services="$(secret_services "$f")"
  [ -n "$services" ] || die "$n keeps no secrets in the Keychain (edit it with: ccp edit $n, or recreate: ccp add $n --force)"
  while IFS= read -r svc; do
    [ -n "$svc" ] || continue
    var="${svc#ccp-$n-}"
    if [ -n "$only" ] && [ "$only" != "$var" ]; then continue; fi
    envname="CCP_SECRET_$var"; val="${!envname:-}"
    if [ -z "$val" ]; then
      [ "$ttyok" = 1 ] || die "key: no terminal; export CCP_SECRET_$var=VALUE"
      val="$(ask_secret "New value for $var ($n)")"
    fi
    if [ -z "$val" ]; then note "skipped $var (empty)"; continue; fi
    kc_set "$svc" "$val" || die "couldn't update Keychain item $svc"
    note "updated $var for $n"; did=1
  done <<EOF
$services
EOF
  if [ "$did" = 0 ]; then
    if [ -n "$only" ]; then die "key: $only is not a stored secret of $n"; fi
    die "key: nothing updated"
  fi
  return 0
}

# ---- loading a provider's environment ---------------------------------------
managed_vars() {
  {
    printf '%s\n' ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_MODEL ANTHROPIC_DEFAULT_MODEL \
      ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION ANTHROPIC_DEFAULT_OPUS_MODEL \
      ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_CUSTOM_HEADERS \
      ANTHROPIC_VERTEX_PROJECT_ID ANTHROPIC_VERTEX_BASE_URL ANTHROPIC_BEDROCK_BASE_URL \
      ANTHROPIC_BEDROCK_MANTLE_BASE_URL ANTHROPIC_BEDROCK_REGION_PREFIX ANTHROPIC_FOUNDRY_RESOURCE \
      ANTHROPIC_FOUNDRY_BASE_URL ANTHROPIC_FOUNDRY_API_KEY ANTHROPIC_FOUNDRY_AUTH_TOKEN \
      CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_MANTLE CLAUDE_CODE_USE_FOUNDRY \
      CLAUDE_CODE_SKIP_VERTEX_AUTH CLAUDE_CODE_SKIP_BEDROCK_AUTH CLAUDE_CODE_SKIP_MANTLE_AUTH \
      CLAUDE_CODE_SKIP_FOUNDRY_AUTH CLOUD_ML_REGION AWS_BEARER_TOKEN_BEDROCK AWS_PROFILE AWS_REGION \
      CLAUDE_CODE_MAX_CONTEXT_TOKENS DISABLE_PROMPT_CACHING
    env | sed -n 's/^\(VERTEX_REGION_CLAUDE_[A-Za-z0-9_]*\)=.*/\1/p'
    cat "$DIR"/*.env 2>/dev/null | sed -n 's/^[[:space:]]*export[[:space:]][[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'
  } | grep -Ev '^(PATH|HOME|USER|LOGNAME|SHELL|TERM|PWD|OLDPWD|TMPDIR|LANG|LC_[A-Z_]+|SHLVL|_|CLAUDE_PROVIDERS_DIR|CLAUDE_PROVIDER|CLAUDE_CONFIG_DIR|CCP_[A-Z_]+)$' | sort -u
}
MANAGED=""
is_managed() {
  [ -n "$MANAGED" ] || MANAGED=" $(managed_vars | tr '\n' ' ') "
  case "$MANAGED" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Clean slate, then source the provider file. Quiet: no network checks, no cloud checks.
source_provider() {
  provider="$1"
  file="$DIR/$provider.env"
  [ -f "$file" ] || die "unknown provider '$provider' (have: $(list_providers | tr '\n' ' '); create one with: ccp add)"
  local v
  # Anything any provider (or Claude Code) uses is cleared first, so nothing leaks between providers.
  for v in $(managed_vars); do unset "$v"; done
  unset -f ccp_check 2>/dev/null
  if needs_setup "$file"; then die "$file still has CHANGE_ME placeholders — edit it first (ccp edit $provider)"; fi
  set -a
  # shellcheck disable=SC1090
  . "$file" || { set +a; die "couldn't load $file"; }
  set +a
}

# source_provider plus the checks that need the network or cloud tools; sets SUMMARY.
load_provider() {
  source_provider "$1"
  local p adc s

  if [ "${CLAUDE_CODE_USE_VERTEX:-}" = 1 ]; then
    if [ -z "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ] && command -v gcloud >/dev/null 2>&1; then
      p="$(gcloud config get-value project 2>/dev/null || true)"
      if [ -n "$p" ]; then export ANTHROPIC_VERTEX_PROJECT_ID="$p"; fi
    fi
    [ -n "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ] || die "no GCP project: set ANTHROPIC_VERTEX_PROJECT_ID in $file or run: gcloud config set project PROJECT_ID"
    [ -n "${CLOUD_ML_REGION:-}" ] || die "CLOUD_ML_REGION is empty in $file"
    adc="${GOOGLE_APPLICATION_CREDENTIALS:-$HOME/.config/gcloud/application_default_credentials.json}"
    if [ ! -f "$adc" ]; then warn "no Google credentials at $adc — run: gcloud auth application-default login"; fi
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ] && command -v curl >/dev/null 2>&1; then
    if ! curl -s -o /dev/null --max-time 2 "${ANTHROPIC_BASE_URL%/}/health/liveliness"; then
      warn "$ANTHROPIC_BASE_URL isn't answering — is the server running?"
    fi
  fi
  if declare -F ccp_check >/dev/null 2>&1; then ccp_check; fi

  for s in "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json"; do
    [ "$PWD" != "$HOME" ] || continue   # in $HOME those are the user files, not a project's
    if [ -f "$s" ] && grep -qE '"(ANTHROPIC_[A-Z_]+|CLAUDE_CODE_USE_[A-Z]+|CLOUD_ML_REGION|AWS_PROFILE|AWS_REGION)"' "$s"; then
      warn "$s sets provider variables for this project; they apply over the provider you pick"
    fi
  done

  SUMMARY="$provider"
  if [ -n "${CLAUDE_CODE_USE_VERTEX:-}" ]; then SUMMARY="$SUMMARY (vertex: project ${ANTHROPIC_VERTEX_PROJECT_ID:-?}, region ${CLOUD_ML_REGION:-?})"; fi
  if [ -n "${CLAUDE_CODE_USE_BEDROCK:-}" ]; then SUMMARY="$SUMMARY (bedrock${AWS_REGION:+: region $AWS_REGION}${AWS_PROFILE:+, profile $AWS_PROFILE})"; fi
  if [ -n "${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then SUMMARY="$SUMMARY (foundry: ${ANTHROPIC_FOUNDRY_RESOURCE:-${ANTHROPIC_FOUNDRY_BASE_URL:-?}})"; fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then SUMMARY="$SUMMARY (gateway: $ANTHROPIC_BASE_URL)"; fi
  if [ -n "${ANTHROPIC_MODEL:-}" ]; then SUMMARY="$SUMMARY model=$ANTHROPIC_MODEL"; fi
}

# The token Claude Code should send, from the loaded provider. Empty when it has none.
provider_token() { printf '%s' "${ANTHROPIC_AUTH_TOKEN:-${ANTHROPIC_API_KEY:-}}"; }

show_env() {
  local v
  for v in $(managed_vars); do
    [ -n "${!v+x}" ] || continue
    if is_secret_name "$v"; then printf '%s=***\n' "$v"; else printf '%s=%s\n' "$v" "${!v}"; fi
  done
}

need_name() {
  local n="${1:-}"
  if [ -z "$n" ]; then n="$(default_provider)"; fi
  [ -n "$n" ] || die "no provider is active yet. Pick one with: ccp use NAME   (see: ccp list)"
  printf '%s' "$n"
}

cmd_show() { local n; n="$(need_name "${1:-}")" || exit 1; load_provider "$n"; echo "ccp: $SUMMARY"; show_env; }

# One direct request to the provider's endpoint, so a 401/404/429 shows in seconds instead of after
# Claude Code's eleven retries. Only for providers whose endpoint and model we know; otherwise skipped.
preflight() {
  command -v curl >/dev/null 2>&1 || return 0
  command -v perl >/dev/null 2>&1 || return 0
  local url body hf code msg gc tok model loc host
  umask 077
  hf="$(mktemp "${TMPDIR:-/tmp}/ccp-hdr.XXXXXX")" || return 0
  if [ "${CLAUDE_CODE_USE_VERTEX:-}" = 1 ]; then
    model="${ANTHROPIC_MODEL:-}"
    [ -n "$model" ] || { rm -f "$hf"; return 0; }   # without a pinned model we can't know what Claude Code will ask for
    gc="$(command -v gcloud 2>/dev/null || true)"
    [ -n "$gc" ] || { [ -x "$HOME/google-cloud-sdk/bin/gcloud" ] && gc="$HOME/google-cloud-sdk/bin/gcloud"; }
    [ -n "$gc" ] || { rm -f "$hf"; return 0; }
    tok="$("$gc" auth application-default print-access-token 2>/dev/null)" || tok=""
    if [ -z "$tok" ]; then rm -f "$hf"; echo "FAIL  $provider: no Google credentials — run: gcloud auth application-default login"; return 1; fi
    loc="${CLOUD_ML_REGION:-us-east5}"
    case "$loc" in
      global) host="https://aiplatform.googleapis.com" ;;
      eu|us)  host="https://aiplatform.$loc.rep.googleapis.com" ;;
      *)      host="https://$loc-aiplatform.googleapis.com" ;;
    esac
    [ -n "${ANTHROPIC_VERTEX_BASE_URL:-}" ] && host="${ANTHROPIC_VERTEX_BASE_URL%/}"
    url="$host/v1/projects/${ANTHROPIC_VERTEX_PROJECT_ID:-}/locations/$loc/publishers/anthropic/models/$model:rawPredict"
    body='{"anthropic_version":"vertex-2023-10-16","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}'
    printf 'Authorization: Bearer %s\n' "$tok" > "$hf"
  elif [ -n "${ANTHROPIC_BASE_URL:-}" ] && [ -z "${CLAUDE_CODE_USE_BEDROCK:-}${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then
    url="${ANTHROPIC_BASE_URL%/}/v1/messages"
    body="{\"model\":\"${ANTHROPIC_MODEL:-claude-sonnet-4-5}\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"
    {
      echo 'anthropic-version: 2023-06-01'
      [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ] && printf 'Authorization: Bearer %s\n' "$ANTHROPIC_AUTH_TOKEN"
      [ -n "${ANTHROPIC_API_KEY:-}" ] && printf 'x-api-key: %s\n' "$ANTHROPIC_API_KEY"
    } > "$hf"
  else
    rm -f "$hf"; return 0
  fi
  code="$(curl -s -o "$hf.out" -w '%{http_code}' --max-time 30 -X POST "$url" -H @"$hf" -H 'Content-Type: application/json' -d "$body" 2>/dev/null)" || code="000"
  if [ "$code" = 000 ]; then   # nothing answered; try once more before giving up
    sleep 1
    code="$(curl -s -o "$hf.out" -w '%{http_code}' --max-time 30 -X POST "$url" -H @"$hf" -H 'Content-Type: application/json' -d "$body" 2>/dev/null)" || code="000"
  fi
  msg="$(perl -MJSON::PP -e '
    local $/; my $t = <STDIN>; my $d = eval { JSON::PP->new->utf8->decode($t) };
    if (ref $d eq "HASH") {
      my $e = $d->{error}; $e = $e->[0]{error} if ref $e eq "ARRAY" && ref $e->[0] eq "HASH";
      if (ref $e eq "HASH") { print $e->{message} // $e->{type} // "" } elsif ($d->{type} && $d->{type} eq "error") { print $d->{error}{message} // "" }
    } else { $t =~ s/<[^>]*>//g; $t =~ s/\s+/ /g; print substr($t, 0, 200) }' < "$hf.out" 2>/dev/null)"
  rm -f "$hf" "$hf.out"
  case "$code" in
    2*) return 0 ;;
    000) echo "FAIL  $provider: no answer from $url"; return 1 ;;
  esac
  echo "FAIL  $provider: HTTP $code from $url"
  [ -n "$msg" ] && echo "      $msg"
  case "$code" in
    429) echo "      The quota for this model is used up or still zero. In the Google Cloud console open IAM & Admin > Quotas, filter on \"anthropic-claude\", and request an increase; also check the model is Enabled in Model Garden." ;;
    404) echo "      The model isn't available at this location, or isn't enabled in Model Garden. Try CLOUD_ML_REGION=global, or another model ID." ;;
    401|403) echo "      The credentials were rejected. Check the key/token, or for Vertex: gcloud auth application-default login and role roles/aiplatform.user." ;;
  esac
  return 1
}

cmd_test() {
  local n out rc ovr reply
  n="$(need_name "${1:-}")" || exit 1
  load_provider "$n"
  command -v claude >/dev/null 2>&1 || die "'claude' not found on PATH"
  note "testing $SUMMARY ..."
  preflight || return 1
  export CCP_PROVIDER="$n"
  ovr="$(launch_overrides)"
  run_start "$n"
  if command -v perl >/dev/null 2>&1; then
    out="$(perl -e 'alarm 120; exec @ARGV' claude ${ovr:+--settings "$ovr"} -p 'Reply with exactly one word: ok' --max-turns 1 2>&1 </dev/null)"; rc=$?
  else
    out="$(claude ${ovr:+--settings "$ovr"} -p 'Reply with exactly one word: ok' --max-turns 1 2>&1 </dev/null)"; rc=$?
  fi
  run_end "$rc"
  [ -n "$ovr" ] && rm -f "$ovr"
  if [ "$rc" = 0 ] && [ -n "$out" ]; then
    reply="$(printf '%s\n' "$out" | grep -v '^\[claude-code:' | grep -v '^[[:space:]]*$' | head -n1)"
    echo "OK  $n works. Reply: ${reply:-$(printf '%s' "$out" | head -n1)}"
    return 0
  fi
  if [ "$rc" = 142 ]; then
    echo "FAIL  $n: no answer after 120 s. Claude Code kept retrying, which usually means the API answers with an error such as 429 (quota) or 404 (model)."
    echo "      See the details with:  ccp $n -p hi --debug   then look in ~/.claude/debug/"
    return 1
  fi
  echo "FAIL  $n (exit $rc):"
  printf '%s\n' "$out" | tail -n 15
  return 1
}

# ---- Claude Code's settings file ------------------------------------------------
# One perl program handles the JSON. Modes (CCP_MODE):
#   read      print "env<TAB>KEY<TAB>value" for every env entry, then "helper<TAB>value"
#   write     apply ops from stdin to the file (backup first):  del KEY | set KEY value | helper CMD | delhelper
#   json      build a settings document from the same ops and print it (used for one-off launches)
# Values on the wire are escaped with esc(): \t \n \\.
SETTINGS_PL=""
read -r -d '' SETTINGS_PL <<'PERL' || true
use strict; use warnings; use JSON::PP;
my $file = $ENV{CCP_FILE}; my $mode = $ENV{CCP_MODE};
my $json = JSON::PP->new->utf8->canonical->pretty->indent_length(2);
sub unesc { my $s = shift; $s =~ s/\\(.)/$1 eq 'n' ? "\n" : $1 eq 't' ? "\t" : $1/ge; return $s; }
sub esc { my $s = shift; $s =~ s/\\/\\\\/g; $s =~ s/\n/\\n/g; $s =~ s/\t/\\t/g; return $s; }
my $d = {}; my $txt = '';
if ($mode ne 'json' && -e $file) {
  open(my $fh, '<:raw', $file) or die "ccp: cannot read $file: $!\n";
  $txt = do { local $/; <$fh> }; close $fh;
  if ($txt =~ /\S/) {
    $d = eval { $json->decode($txt) };
    die "ccp: $file is not valid JSON. Fix it (a copy may be at $file.ccp-backup) before switching providers.\n"
      unless $d && ref $d eq 'HASH';
  }
}
if ($mode eq 'read') {
  my $env = $d->{env};
  if (ref $env eq 'HASH') {
    for my $k (sort keys %$env) { my $v = $env->{$k}; $v = '' unless defined $v; print "env\t$k\t" . esc("$v") . "\n"; }
  }
  my $h = $d->{apiKeyHelper}; $h = '' unless defined $h && !ref $h;
  print "helper\t" . esc("$h") . "\n";
  exit 0;
}
my $env = (ref $d->{env} eq 'HASH') ? $d->{env} : {};
my $changed = 0;
while (my $l = <STDIN>) {
  chomp $l; next unless length $l;
  my ($op, $k, $v) = split /\t/, $l, 3;
  $k = '' unless defined $k; $v = '' unless defined $v;
  if ($op eq 'del') { if (exists $env->{$k}) { delete $env->{$k}; $changed++; } }
  elsif ($op eq 'set') { $v = unesc($v); if (!exists $env->{$k} || !defined $env->{$k} || $env->{$k} ne $v) { $env->{$k} = $v; $changed++; } }
  elsif ($op eq 'helper') { $k = unesc($k); if (!defined $d->{apiKeyHelper} || $d->{apiKeyHelper} ne $k) { $d->{apiKeyHelper} = $k; $changed++; } }
  elsif ($op eq 'delhelper') {
    if (defined $d->{apiKeyHelper} && !ref $d->{apiKeyHelper} && $d->{apiKeyHelper} =~ /(^|[\/ ])ccp auth$/) { delete $d->{apiKeyHelper}; $changed++; }
  }
}
if (%$env) { $d->{env} = $env; } else { delete $d->{env}; }
if ($mode eq 'json') { print $json->encode($d); exit 0; }
if (!$changed && -e $file) { print "unchanged\t$file\n"; exit 0; }
my $dir = $file; $dir =~ s{/[^/]*$}{}; $dir = '.' if $dir eq '';
if (-e $file) {
  my $orig = "$file.ccp-original"; my $bak = "$file.ccp-backup";
  for my $b ($orig, $bak) {
    next if $b eq $orig && -e $orig;
    open(my $o, '>:raw', $b) or die "ccp: cannot write backup $b: $!\n"; print $o $txt; close $o; chmod 0600, $b;
  }
  print "backup\t$bak\n";
}
my $tmp = "$file.ccp-tmp.$$";
open(my $w, '>:raw', $tmp) or die "ccp: cannot write $tmp: $!\n";
print $w $json->encode($d); close $w;
my $mode_bits = (-e $file) ? ((stat $file)[2] & 07777) : 0600;
chmod $mode_bits, $tmp;
rename $tmp, $file or die "ccp: cannot replace $file: $!\n";
print "written\t$file\n";
PERL

settings_read()  { CCP_FILE="$SETTINGS" CCP_MODE=read perl -e "$SETTINGS_PL"; }
settings_write() { mkdir -p "$CLAUDE_DIR" 2>/dev/null; CCP_FILE="$SETTINGS" CCP_MODE=write perl -e "$SETTINGS_PL"; }
settings_json()  { CCP_FILE="$SETTINGS" CCP_MODE=json perl -e "$SETTINGS_PL"; }

# Provider variables currently in the settings file, as "KEY<TAB>escaped value" lines.
settings_managed() {
  local kind k v
  settings_read 2>/dev/null | while IFS=$'\t' read -r kind k v; do
    if [ "$kind" = env ] && is_managed "$k"; then printf '%s\t%s\n' "$k" "$v"; fi
  done
}
settings_helper() { settings_read 2>/dev/null | sed -n 's/^helper\t//p' | head -n1; }
is_our_helper() { case "$1" in *"ccp auth") return 0 ;; *) return 1 ;; esac; }

helper_command() {
  local me
  me="$(self_path)"; [ -n "$me" ] || die "can't work out where ccp lives"
  printf '%s auth' "$(printf '%q' "$me")"
}

# Remove everything ccp put into the settings file.
settings_clear() {
  local v ops=""
  for v in $(managed_vars); do ops="${ops}del"$'\t'"$v"$'\n'; done
  ops="${ops}delhelper"$'\n'
  printf '%s' "$ops" | settings_write >/dev/null
}

# The ops that make the settings file match the loaded provider (also recorded in $APPLIED).
provider_ops() {
  local v ops="" token
  for v in $(managed_vars); do ops="${ops}del"$'\t'"$v"$'\n'; done
  token="$(provider_token)"
  for v in $(managed_vars); do
    [ -n "${!v+x}" ] || continue
    case "$v" in ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY) continue ;; esac
    ops="${ops}set"$'\t'"$v"$'\t'"$(esc "${!v}")"$'\n'
  done
  if [ -n "$token" ]; then ops="${ops}helper"$'\t'"$(esc "$(helper_command)")"$'\n'
  else ops="${ops}delhelper"$'\n'; fi
  printf '%s' "$ops"
}

cmd_use() {
  local n="${1:-}" v ops out
  [ -n "$n" ] || die "usage: ccp use NAME   (or: ccp use none)"
  if [ "$n" = none ] || [ "$n" = off ]; then
    command -v perl >/dev/null 2>&1 || die "perl is needed to edit $SETTINGS"
    settings_clear
    rm -f "$DIR/default" "$APPLIED"
    echo "ccp: no provider is active. Claude Code uses its own sign-in and settings again."
    return 0
  fi
  [ -f "$DIR/$n.env" ] || die "no provider '$n' (see: ccp list)"
  command -v perl >/dev/null 2>&1 || die "perl is needed to edit $SETTINGS"
  load_provider "$n"
  for v in $(managed_vars); do
    [ -n "${!v+x}" ] || continue
    case "$v" in ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY) continue ;; esac
    if is_secret_name "$v" && [ -n "${!v}" ]; then
      warn "$v is written to $SETTINGS in plain text; Claude Code has no other way to receive it"
    fi
  done
  ops="$(provider_ops)"
  out="$(printf '%s' "$ops" | settings_write)" || exit 1
  umask 077
  { echo "provider"$'\t'"$n"; printf '%s' "$ops" | grep -E '^(set|helper)'$'\t' || true; } > "$APPLIED"
  echo "$n" > "$DIR/default"
  echo "ccp: claude now uses $SUMMARY"
  case "$out" in *backup*) echo "ccp: updated $SETTINGS (previous copy: $SETTINGS.ccp-backup)" ;; esac
  echo "ccp: this applies to every new Claude Code session: Terminal, iTerm, VS Code, and other editors. Sessions already running keep their old endpoint and key, though Claude Code picks up model names from the file live, so restart them too."
}

# ---- the apiKeyHelper Claude Code calls ----------------------------------------------
cmd_auth() {
  local n tok
  n="${CCP_PROVIDER:-$(active_provider)}"
  [ -n "$n" ] || { echo "ccp auth: no provider is active (ccp use NAME)" >&2; exit 1; }
  source_provider "$n" 2>/dev/null
  tok="$(provider_token)"
  [ -n "$tok" ] || { echo "ccp auth: $n has no API key or token" >&2; exit 1; }
  printf '%s' "$tok"
}

# ---- state: does Claude Code's settings file still say what ccp wrote? -------------------
# Sets STATE (synced|drift|stale|foreign|unset) and DIFF_KEYS (space separated).
compute_state() {
  local active cur exp curh exph k v ck cv found
  STATE=unset; DIFF_KEYS=""
  active="$(active_provider)"
  cur="$(settings_managed)"
  curh="$(settings_helper)"
  is_our_helper "$curh" || curh=""
  if [ -f "$APPLIED" ]; then
    exp="$(sed -n 's/^set\t//p' "$APPLIED")"
    exph="$(sed -n 's/^helper\t//p' "$APPLIED" | head -n1)"
    if [ "$(printf '%s' "$cur" | sort)" = "$(printf '%s' "$exp" | sort)" ] && [ "$curh" = "$exph" ]; then
      STATE=synced
    else
      STATE=drift
      while IFS=$'\t' read -r k v; do
        [ -n "$k" ] || continue
        found=0
        while IFS=$'\t' read -r ck cv; do
          if [ "$ck" = "$k" ] && [ "$cv" = "$v" ]; then found=1; break; fi
        done <<EOF
$exp
EOF
        [ "$found" = 1 ] || DIFF_KEYS="$DIFF_KEYS $k"
      done <<EOF
$cur
EOF
      while IFS=$'\t' read -r k v; do
        [ -n "$k" ] || continue
        found=0
        while IFS=$'\t' read -r ck cv; do
          if [ "$ck" = "$k" ]; then found=1; break; fi
        done <<EOF
$cur
EOF
        [ "$found" = 1 ] || DIFF_KEYS="$DIFF_KEYS $k"
      done <<EOF
$exp
EOF
      if [ "$curh" != "$exph" ]; then DIFF_KEYS="$DIFF_KEYS apiKeyHelper"; fi
    fi
  elif [ -n "$active" ]; then
    STATE=stale
    while IFS=$'\t' read -r k v; do [ -n "$k" ] && DIFF_KEYS="$DIFF_KEYS $k"; done <<EOF
$cur
EOF
  elif [ -n "$cur" ] || [ -n "$curh" ]; then
    STATE=foreign
    while IFS=$'\t' read -r k v; do [ -n "$k" ] && DIFF_KEYS="$DIFF_KEYS $k"; done <<EOF
$cur
EOF
  fi
  DIFF_KEYS="$(trim "$DIFF_KEYS")"
}

cmd_status() {
  local plain=0 active k c hook="missing"
  [ "${1:-}" = "--plain" ] && plain=1
  command -v perl >/dev/null 2>&1 || die "perl is needed to read $SETTINGS"
  active="$(active_provider)"
  compute_state
  if hook_in "$(rc_files | head -n1)"; then hook=installed; fi
  c="$(command -v claude 2>/dev/null || true)"
  if [ "$plain" = 1 ]; then
    printf 'active\t%s\n' "$active"
    printf 'state\t%s\n' "$STATE"
    printf 'settings\t%s\n' "$SETTINGS"
    for k in $DIFF_KEYS; do printf 'key\t%s\n' "$k"; done
    printf 'helper\t%s\n' "$(is_our_helper "$(settings_helper)" && echo on || echo off)"
    printf 'hook\t%s\n' "$hook"
    printf 'claude\t%s\n' "$c"
    return 0
  fi
  case "$STATE" in
    synced)  echo "claude uses $active (settings in $SETTINGS match)" ;;
    drift)   echo "claude was switched to $active, but $SETTINGS has changed since: $DIFF_KEYS"
             echo "  re-apply with: ccp use $active" ;;
    stale)   echo "$active is chosen but hasn't been applied to Claude Code yet: ccp use $active"
             [ -n "$DIFF_KEYS" ] && echo "  until then $SETTINGS decides, with: $DIFF_KEYS" ;;
    foreign) echo "no provider is active; $SETTINGS sets provider variables by hand: $DIFF_KEYS"
             echo "  keep them as a provider with: ccp import NAME    then: ccp use NAME" ;;
    unset)   echo "no provider is active; Claude Code uses its own sign-in" ;;
  esac
  if [ "$hook" = installed ]; then echo "plain claude launches are recorded for Usage (shell hook on)"; fi
}

# ---- keep the settings someone typed by hand, as a provider --------------------------
cmd_import() {
  local name="" force=0 a k v kind="custom" lines="" headers="" svc n=0 raw
  for a in "$@"; do case "$a" in -f|--force) force=1 ;; -*) die "import: unknown option $a" ;; *) name="$a" ;; esac; done
  [ -n "$name" ] || die "usage: ccp import NAME [--force]"
  valid_name "$name" || die "import: invalid name '$name' (letters, digits, - and _; not a ccp command word)"
  command -v perl >/dev/null 2>&1 || die "perl is needed to read $SETTINGS"
  local out="$DIR/$name.env"
  if [ -e "$out" ] && [ "$force" = 0 ]; then die "import: '$name' already exists (replace with --force)"; fi
  local cur; cur="$(settings_managed)"
  [ -n "$cur" ] || die "import: $SETTINGS has no provider variables to import"
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    raw="$(printf '%b' "${v//%/%%}")"
    case "$k" in
      CLAUDE_CODE_USE_BEDROCK) [ "$raw" = 1 ] && kind=bedrock ;;
      CLAUDE_CODE_USE_VERTEX)  [ "$raw" = 1 ] && kind=vertex ;;
      CLAUDE_CODE_USE_FOUNDRY) [ "$raw" = 1 ] && kind=foundry ;;
      ANTHROPIC_BASE_URL) if [ "$kind" = custom ]; then case "$raw" in *litellm*|*:4000*) kind=litellm ;; *) kind=gateway ;; esac; fi ;;
      ANTHROPIC_API_KEY) [ "$kind" = custom ] && kind=anthropic ;;
    esac
    if is_secret_name "$k" && [ -n "$raw" ] && have_security; then
      svc="ccp-$name-$k"
      kc_set "$svc" "$raw" || die "import: couldn't store $k in the Keychain"
      headers="$headers# secret-service: $svc"$'\n'
      lines="${lines}export $k=\"\$(ccp_secret $svc)\""$'\n'
    else
      lines="${lines}export $k=$(printf '%q' "$raw")"$'\n'
    fi
    n=$((n+1))
  done <<EOF
$cur
EOF
  umask 077
  mkdir -p "$DIR"
  {
    echo "# description: Imported from Claude Code's settings on $(date '+%Y-%m-%d')"
    echo "# template: custom"
    echo "# kind: $kind"
    printf '%s' "$headers"
    echo
    printf '%s' "$lines"
  } > "$out"
  chmod 600 "$out"
  note "created $out with $n variable(s)${headers:+; secrets moved to the Keychain}"
  echo "ccp: switch to it with: ccp use $name"
}

# A settings document for one launch, so this session beats whatever is in the settings file.
# Prints the path of a temp file, or nothing when the file needs no overriding.
launch_overrides() {
  local k v ops="" need=0 h tmp
  command -v perl >/dev/null 2>&1 || return 0
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    if [ -n "${!k+x}" ]; then
      if [ "$(esc "${!k}")" != "$v" ]; then need=1; fi
      ops="${ops}set"$'\t'"$k"$'\t'"$(esc "${!k}")"$'\n'
    else
      need=1
      ops="${ops}set"$'\t'"$k"$'\t'$'\n'
    fi
  done <<EOF
$(settings_managed)
EOF
  h="$(settings_helper)"
  if [ -n "$h" ] && [ -z "$(provider_token)" ]; then need=1; ops="${ops}helper"$'\t'$'\n'; fi
  [ "$need" = 1 ] || return 0
  umask 077
  tmp="$(mktemp "${TMPDIR:-/tmp}/ccp-settings.XXXXXX")" || return 0
  printf '%s' "$ops" | settings_json > "$tmp" || { rm -f "$tmp"; return 0; }
  printf '%s' "$tmp"
}

# ---- usage log ----------------------------------------------------------------
RUNLOG="$DIR/usage/runs.log"
RUN_OPEN=0
run_start() {
  mkdir -p "$DIR/usage" 2>/dev/null && chmod 700 "$DIR/usage" 2>/dev/null
  printf 'S\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$$" "$1" "$(pwd -P | tr '\t\n' '  ')" >>"$RUNLOG" 2>/dev/null
  RUN_OPEN=1
}
run_end() {
  [ "$RUN_OPEN" = 1 ] || return 0
  RUN_OPEN=0
  printf 'E\t%s\t%s\t%s\n' "$(date +%s)" "$$" "${1:-0}" >>"$RUNLOG" 2>/dev/null
}

# ---- optional shell hook: plain `claude` runs through ccp so launches are recorded ------------
RC_BEGIN='# >>> ccp (Claude provider switcher) >>>'
RC_END='# <<< ccp <<<'
rc_files() {
  if [ -n "${CCP_RC_FILE:-}" ]; then echo "$CCP_RC_FILE"; return; fi
  case "${SHELL:-}" in
    */bash) echo "$HOME/.bash_profile"; if [ -f "$HOME/.bashrc" ]; then echo "$HOME/.bashrc"; fi ;;
    *) echo "$HOME/.zshrc" ;;
  esac
}
self_path() {
  local d
  d="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || d=""
  if [ -n "$d" ] && [ -x "$d/$(basename "$0")" ]; then echo "$d/$(basename "$0")"; else command -v ccp; fi
}
hook_in() { [ -f "$1" ] && grep -qxF "$RC_BEGIN" "$1"; }
hook_strip() {
  awk -v b="$RC_BEGIN" -v e="$RC_END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip{print}' "$1" |
    awk '/^[[:space:]]*$/{n++; next} {while(n>0){print ""; n--} print}'
}
cmd_shell() {
  local act="${1:-status}" f me tmp any=1
  case "$act" in
    status)
      for f in $(rc_files); do
        if hook_in "$f"; then printf 'installed\t%s\n' "$f"; any=0; else printf 'missing\t%s\n' "$f"; fi
      done
      return $any ;;
    install)
      me="$(self_path)"; [ -n "$me" ] || die "can't work out where ccp lives"
      for f in $(rc_files); do
        if [ -f "$f" ] && [ ! -e "$f.ccp-backup" ]; then cp -p "$f" "$f.ccp-backup"; fi
        tmp="$(mktemp "${TMPDIR:-/tmp}/ccp-rc.XXXXXX")" || die "no temp file"
        if [ -f "$f" ]; then hook_strip "$f" > "$tmp"; fi
        {
          [ -s "$tmp" ] && echo
          echo "$RC_BEGIN"
          echo '# Plain `claude` runs through ccp so Switchboard can record which provider each session used.'
          echo '# Skip it once with: command claude'
          printf 'claude() {\n  if [ -x %q ]; then %q run "$@"; else command claude "$@"; fi\n}\n' "$me" "$me"
          echo "$RC_END"
        } >> "$tmp"
        cat "$tmp" > "$f" || { rm -f "$tmp"; die "couldn't write $f"; }
        rm -f "$tmp"
        printf 'installed\t%s\n' "$f"
      done
      return 0 ;;
    remove)
      for f in $(rc_files); do
        if hook_in "$f"; then
          tmp="$(mktemp "${TMPDIR:-/tmp}/ccp-rc.XXXXXX")" || die "no temp file"
          hook_strip "$f" > "$tmp"
          cat "$tmp" > "$f" || { rm -f "$tmp"; die "couldn't write $f"; }
          rm -f "$tmp"
          printf 'removed\t%s\n' "$f"
        else
          printf 'missing\t%s\n' "$f"
        fi
      done
      return 0 ;;
    *) die "usage: ccp shell install|remove|status" ;;
  esac
}

# ---- provider variables in the settings file that ccp didn't put there ------------------------
cmd_overrides() {
  local fix=0 k ops=""
  if [ "${1:-}" = "--fix" ]; then fix=1; fi
  command -v perl >/dev/null 2>&1 || die "perl is needed for this"
  compute_state
  case "$STATE" in drift|foreign) ;; *) return 0 ;; esac
  for k in $DIFF_KEYS; do
    [ "$k" = apiKeyHelper ] && continue
    if [ "$fix" = 0 ]; then printf '%s\t%s\n' "$SETTINGS" "$k"; else ops="${ops}del"$'\t'"$k"$'\n'; fi
  done
  if [ "$fix" = 1 ] && [ -n "$ops" ]; then
    printf '%s' "$ops" | settings_write | sed -n 's/^backup\t/backup\t/p'
    for k in $DIFF_KEYS; do [ "$k" = apiKeyHelper ] || printf 'removed\t%s\t%s\n' "$SETTINGS" "$k"; done
    # Put back what the active provider needs, so a fix never leaves it half applied.
    local active; active="$(active_provider)"
    if [ -n "$active" ] && [ -f "$APPLIED" ]; then grep -E '^(set|helper)'$'\t' "$APPLIED" | settings_write >/dev/null; fi
  fi
  return 0
}

# ---- doctor -----------------------------------------------------------------
d_ok()   { echo "  [ok]   $*"; }
d_warn() { echo "  [warn] $*"; }
d_bad()  { echo "  [FAIL] $*"; D_BAD=$((D_BAD+1)); }

cmd_doctor() {
  D_BAD=0
  local c p f perm svc s hits cur
  echo "claude"
  if c="$(command -v claude)"; then d_ok "$c ($(claude --version 2>/dev/null | head -n1))"; else d_bad "'claude' not found on PATH"; fi
  if command -v ccp >/dev/null 2>&1; then d_ok "ccp is on PATH ($(command -v ccp))"; else d_warn "ccp isn't on PATH — add to ~/.zshrc:  export PATH=\"\$HOME/bin:\$PATH\""; fi
  command -v perl >/dev/null 2>&1 || d_bad "perl not found; ccp needs it to edit $SETTINGS"

  echo "active provider"
  cur="$(active_provider)"
  if command -v perl >/dev/null 2>&1; then
    compute_state
    case "$STATE" in
      synced)  d_ok "claude uses $cur; $SETTINGS matches" ;;
      drift)   d_bad "$SETTINGS changed since you switched to $cur ($DIFF_KEYS) — re-apply: ccp use $cur" ;;
      stale)   d_bad "$cur is chosen but not applied to Claude Code — run: ccp use $cur" ;;
      foreign) d_bad "$SETTINGS sets provider variables by hand ($DIFF_KEYS); they decide what claude uses — keep them: ccp import NAME, then switch: ccp use NAME" ;;
      unset)   d_warn "no provider is active; claude uses its own sign-in — pick one: ccp use NAME" ;;
    esac
    if [ "$STATE" = synced ] && [ -f "$APPLIED" ] && grep -q '^helper'$'\t' "$APPLIED"; then
      if CCP_PROVIDER="$cur" "$(self_path)" auth >/dev/null 2>&1; then d_ok "Claude Code can fetch the key for $cur from the Keychain (ccp auth)"
      else d_bad "ccp auth can't produce a key for $cur — check its Keychain item: ccp key $cur"; fi
    fi
  fi
  if [ -n "$cur" ] && [ ! -f "$DIR/$cur.env" ]; then d_bad "active provider '$cur' doesn't exist (ccp use NAME)"; fi
  if hook_in "$(rc_files | head -n1)"; then d_ok "plain claude launches are recorded for Usage (shell hook on)"
  else d_ok "plain claude isn't recorded for Usage (optional: ccp shell install)"; fi

  echo "providers ($DIR)"
  if [ -z "$(list_providers)" ]; then d_warn "none yet — run: ccp add"; fi
  for p in $(list_providers); do
    f="$DIR/$p.env"
    if [ "$p" = "$cur" ]; then d_ok "$p (active)"; else d_ok "$p"; fi
    if needs_setup "$f"; then d_warn "$p still has CHANGE_ME placeholders (ccp edit $p)"; fi
    perm="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null)"
    case "$perm" in *00) ;; *) d_warn "$p.env is readable by others (mode $perm) — chmod 600 $f" ;; esac
    if plaintext_secret_in "$f"; then
      d_warn "$p.env holds a plaintext secret — move it to the Keychain: ccp add $p --force"
    fi
    while IFS= read -r svc; do
      [ -n "$svc" ] || continue
      if kc_has "$svc"; then d_ok "$p: Keychain item ${svc#ccp-$p-} present"; else d_bad "$p: Keychain item ${svc#ccp-$p-} missing — ccp key $p"; fi
    done <<EOF
$(secret_services "$f")
EOF
  done

  echo "things that could override your choice"
  hits=0
  for s in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zshenv" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    if [ -f "$s" ]; then
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        d_warn "$s:$p — exported in your shell; Claude Code reads it when the settings file doesn't set the same variable"; hits=1
      done <<EOF
$(grep -nE '^[[:space:]]*export[[:space:]]+(ANTHROPIC_|CLAUDE_CODE_USE_|CLOUD_ML_REGION)' "$s" | sed 's/=.*//')
EOF
    fi
  done
  for s in "$CLAUDE_DIR/settings.local.json" "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json"; do
    if [ "$PWD" = "$HOME" ]; then case "$s" in "$PWD/"*) continue ;; esac; fi   # in $HOME those are the user files
    if [ -f "$s" ] && grep -qE '"(ANTHROPIC_[A-Z_]+|CLAUDE_CODE_USE_[A-Z]+|CLOUD_ML_REGION|AWS_PROFILE|AWS_REGION)"' "$s"; then
      d_bad "$s sets provider variables in its \"env\" block; Claude Code applies them over the active provider. Remove those keys."; hits=1
    fi
  done
  if [ "$hits" = 0 ]; then d_ok "no overrides found in shell profiles or project settings"; fi
  [ "$D_BAD" = 0 ]
}

# ---- dispatch ---------------------------------------------------------------
sub="${1:-}"
case "$sub" in
  --version) echo "ccp $CCP_VERSION"; exit 0 ;;
  help|-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  -l|--list)
    cur="$(active_provider)"
    for p in $(list_providers); do
      if [ "$p" = "$cur" ]; then echo "* $p (active)"; else echo "  $p"; fi
    done
    exit 0 ;;
  list|ls) cmd_list; exit $? ;;
  templates|template) cmd_templates "${2:-}"; exit $? ;;
  template-vars)
    [ -f "$TPL_DIR/${2:-}.tpl" ] || die "unknown template '${2:-}'"
    tpl_specs "$TPL_DIR/$2.tpl"; exit 0 ;;
  secrets)
    [ -f "$DIR/${2:-}.env" ] || die "no provider '${2:-}'"
    secret_services "$DIR/$2.env" | while IFS= read -r svc; do [ -n "$svc" ] && echo "${svc#ccp-$2-}"; done
    exit 0 ;;
  add|new) shift; cmd_add "$@"; exit $? ;;
  import) shift; cmd_import "$@"; exit $? ;;
  edit) shift; cmd_edit "$@"; exit $? ;;
  remove|rm) shift; cmd_remove "$@"; exit $? ;;
  key) shift; cmd_key "$@"; exit $? ;;
  show) cmd_show "${2:-}"; exit $? ;;
  test) cmd_test "${2:-}"; exit $? ;;
  doctor) cmd_doctor; exit $? ;;
  status) cmd_status "${2:-}"; exit $? ;;
  auth) cmd_auth; exit $? ;;
  shell) shift; cmd_shell "$@"; exit $? ;;
  overrides) shift; cmd_overrides "$@"; exit $? ;;
  use|default|--default) shift; cmd_use "$@"; exit $? ;;
esac

provider=""
if [ "$sub" = run ]; then
  shift
elif [ -n "${1:-}" ] && [ -f "$DIR/$1.env" ]; then
  provider="$1"; shift
elif [ -n "${1:-}" ] && [ "${1#-}" = "$1" ]; then
  die "'$1' is neither a provider nor a command (see: ccp list, ccp help)"
fi
[ -n "$provider" ] || provider="$(default_provider)"
[ -n "$provider" ] || die "no provider is active yet. Pick one with: ccp use NAME   (see: ccp list)"
load_provider "$provider"
export CCP_PROVIDER="$provider"
OVR="$(launch_overrides)"
cleanup() { [ -n "$OVR" ] && rm -f "$OVR"; }

if [ -n "${CCP_DRY_RUN:-}" ]; then
  echo "ccp: $SUMMARY"; show_env
  if [ -n "$OVR" ]; then echo "ccp: settings overridden for this launch:"; mask_json < "$OVR"; fi
  cleanup; exit 0
fi
command -v claude >/dev/null 2>&1 || { cleanup; die "'claude' not found on PATH"; }
echo "ccp: claude -> $SUMMARY" >&2
run_start "$provider"
trap ':' INT
trap 'run_end 129; cleanup; exit 129' HUP
trap 'run_end 143; cleanup; exit 143' TERM
if [ -n "$OVR" ]; then claude --settings "$OVR" "$@"; else claude "$@"; fi
rc=$?
run_end "$rc"
cleanup
exit "$rc"
